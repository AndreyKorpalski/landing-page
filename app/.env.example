# Copie para .env e preencha com os valores do seu projeto Supabase.
# Essas chaves vão dentro do app (bundle), por isso usam só a anon key,
# que é segura para expor ao cliente (protegida pelas RLS policies).
EXPO_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<SUA_ANON_KEY>
