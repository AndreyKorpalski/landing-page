# Secrets das Edge Functions - nunca commitar valores reais.
# Configure em produção com: supabase secrets set --env-file supabase/.env
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetados automaticamente
# pelo runtime das Edge Functions, não precisam ser definidos aqui)

ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
DEFAULT_CHARGE_AMOUNT=
